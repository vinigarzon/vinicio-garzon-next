# Variables del módulo de reservas (/book).
# Local: copia este archivo a .env.local y rellena los valores.
# Producción: los mismos nombres en Netlify → Site configuration → Environment variables.
# Ninguna es NEXT_PUBLIC: todas viven solo en el servidor.

# --- Supabase (proyecto viniciogarzon-book) --------------------------------
# Settings → Data API → Project URL
BOOK_SUPABASE_URL=
# Settings → API Keys → service_role  (secreta: nunca en el navegador ni en git)
BOOK_SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (proyecto propio de Google Cloud: "viniciogarzon-book") ---
# Google Auth Platform → Clients → tu cliente "Web application"
BOOK_GOOGLE_CLIENT_ID=
BOOK_GOOGLE_CLIENT_SECRET=
# En producción: https://www.viniciogarzon.com/api/book/google/callback
# En local:      http://localhost:3000/api/book/google/callback
BOOK_GOOGLE_REDIRECT_URI=https://www.viniciogarzon.com/api/book/google/callback

# --- Admin del módulo (/book/admin) ----------------------------------------
# Contraseña para entrar. Se compara en el servidor: nunca llega al navegador.
BOOK_ADMIN_PASSWORD=
# Cadena larga y aleatoria para firmar la cookie de sesión.
# Generar con: openssl rand -base64 32
BOOK_SESSION_SECRET=

# --- Correos (Resend) -------------------------------------------------------
BOOK_RESEND_API_KEY=
# Remitente. Debe estar en un dominio verificado en Resend.
BOOK_FROM_EMAIL=Vinicio Garzón <hola@viniciogarzon.com>
# A dónde llegan los avisos de nueva reserva / cancelación.
BOOK_HOST_EMAIL=yo@viniciogarzon.com

# --- Sitio ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.viniciogarzon.com
